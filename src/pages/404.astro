---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { WHATSAPP, wa } from '../data/site';
import { caja, rejilla } from '../lib/iso';

const u = 30;
const piso = rejilla(6, 6, 1, u);
const bloque = caja(2, 2, 0, 2, 2, 0.4, u);
const MSG = 'Hola DukeNet, quiero información para la web de mi negocio.';
const destinos = [
  { href: '/#plantilla', n: '01', t: 'Por qué' },
  { href: '/#obras', n: '02', t: 'Qué hacemos' },
  { href: '/#montaje', n: '03', t: 'Cómo' },
  { href: '/#entregadas', n: '04', t: 'Obras' },
  { href: '/#panel', n: '05', t: 'Datos' },
  { href: '/#contacto', n: '06', t: 'Cotizar' },
];
---
<Base
  title="Esta ruta no existe · DukeNet"
  description="La página que buscabas se movió o nunca se construyó. Vuelve al inicio o escríbenos por WhatsApp."
  robots="noindex, follow"
>
  <main id="contenido" class="e404">
    <div class="marco e404__grid">
      <div>
        <p class="cap__num">Error 404</p>
        <h1 class="e404__tit">Esta ruta<br /><span class="azul">no existe</span></h1>
        <p class="lead e404__lead">La página que buscabas se movió o nunca se construyó. Te devolvemos al inicio, o escríbenos y lo resolvemos por WhatsApp.</p>
        <div class="e404__cta">
          <a class="btn btn--azul" href="/">Volver al inicio <Icon name="arrow-ur" /></a>
          {WHATSAPP.map((w) => (
            <a class="btn btn--linea" href={wa(w.tel, MSG)} target="_blank" rel="noopener"><Icon name="whatsapp" /> {w.label}</a>
          ))}
        </div>
      </div>

      <div class="e404__escena">
        <svg class="iso" viewBox="-200 -150 400 320" role="img" aria-label="Ilustración: un lote vacío con un solo bloque">
          <path class="malla" d={piso} />
          <g>
            <polygon class="der der--gris" points={bloque.der} />
            <polygon class="izq izq--gris" points={bloque.izq} />
            <polygon class="top top--gris" points={bloque.top} />
          </g>
        </svg>
      </div>
    </div>

    <nav class="e404__rutas marco" aria-label="Secciones del sitio">
      <ul>
        {destinos.map((d) => (
          <li><a href={d.href}><span>{d.n}</span>{d.t}<Icon name="arrow-ur" /></a></li>
        ))}
      </ul>
    </nav>
  </main>
</Base>

<style>
  .e404 { min-height: 100svh; display: grid; align-content: center; padding-block: clamp(80px, 12vh, 150px); }
  .e404__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: clamp(28px, 5vw, 70px); align-items: center; }
  .e404__tit { margin-top: 18px; font-size: var(--fs-hero); font-weight: 800; letter-spacing: -0.045em; line-height: 0.92; }
  .azul { color: var(--azul-300); }
  .e404__lead { margin-top: 20px; }
  .e404__cta { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 12px; }
  .e404__escena .iso { filter: drop-shadow(0 40px 50px rgba(0, 0, 0, 0.5)); }

  .e404__rutas { margin-top: clamp(44px, 6vw, 80px); }
  .e404__rutas ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: color-mix(in srgb, var(--papel) 12%, transparent); border-block: 1px solid color-mix(in srgb, var(--papel) 12%, transparent); }
  .e404__rutas a { display: flex; align-items: center; gap: 12px; padding: 16px 14px; background: var(--tinta); text-decoration: none; font-weight: 700; transition: background 0.4s var(--ease); }
  .e404__rutas a:hover { background: var(--tinta-2); }
  .e404__rutas span { font-family: var(--mono); font-size: var(--fs-mini); color: var(--azul-300); font-weight: 400; }
  .e404__rutas :global(svg) { width: 15px; height: 15px; margin-left: auto; opacity: 0.6; }

  @media (max-width: 900px) {
    .e404__grid { grid-template-columns: minmax(0, 1fr); }
    .e404__escena { order: -1; max-width: 360px; margin-inline: auto; }
    .e404__rutas ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .e404__rutas ul { grid-template-columns: minmax(0, 1fr); }
    .e404__cta .btn { width: 100%; justify-content: center; }
  }
</style>
