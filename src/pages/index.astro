---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Portada from '../components/Portada.astro';
import Porque from '../components/Porque.astro';
import Servicios from '../components/Servicios.astro';
import Proceso from '../components/Proceso.astro';
import Obras from '../components/Obras.astro';
import Datos from '../components/Datos.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="DukeNet · Webs a medida que venden, en toda Colombia"
  description="Estudio de desarrollo web en Colombia. Diseñamos y programamos desde cero tu tienda en línea, página de negocio o landing, con datos y acompañamiento mensual."
>
  <Header />
  <main id="contenido">
    <Portada />
    <Porque />
    <Servicios />
    <Proceso />
    <Obras />
    <Datos />
    <Contacto />
  </main>
  <Footer />
  <script>
    import '../scripts/app';
  </script>
</Base>
