---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Portada from '../components/Portada.astro';
import Plantilla from '../components/Plantilla.astro';
import Servicios from '../components/Servicios.astro';
import Montaje from '../components/Montaje.astro';
import Entregadas from '../components/Entregadas.astro';
import Panel from '../components/Panel.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="DukeNet · Webs a medida que venden, en toda Colombia"
  description="Estudio de desarrollo web en Colombia. Diseñamos y programamos desde cero tu tienda en línea, página de negocio o landing, con datos y acompañamiento mensual."
>
  <Header />
  <main id="contenido">
    <Portada />
    <Plantilla />
    <Servicios />
    <Montaje />
    <Entregadas />
    <Panel />
    <Contacto />
  </main>
  <Footer />
  <script>
    import '../scripts/app';
  </script>
</Base>
