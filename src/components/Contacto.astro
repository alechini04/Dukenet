---
import Icon from './Icon.astro';
import { WHATSAPP, wa, SERVICIOS } from '../data/site';
const opciones = [...SERVICIOS.map((s) => ({ letra: s.letra, nombre: s.nombre })), { letra: 'E', nombre: 'Mejorar la que ya tengo' }, { letra: '?', nombre: 'Todavía no lo sé' }];
const MSG = 'Hola DukeNet, quiero cotizar la web de mi negocio.';
---
<section id="contacto" class="cap contacto" data-cap="contacto" aria-labelledby="contacto-tit">
  <div class="marco contacto__grid">
    <div class="contacto__texto">
      <p class="cap__num">06 · Hablemos</p>
      <h2 id="contacto-tit" class="titulo" data-parte>Cotiza tu<br /><span class="azul">web hoy</span></h2>
      <p class="lead contacto__lead" data-sube>Cuéntanos de tu negocio y en una reunión te decimos qué necesitas, cuánto cuesta y cuándo queda listo. Tomamos pocos proyectos al mes.</p>

      <ul class="tels" data-sube>
        {WHATSAPP.map((w) => (
          <li>
            <a href={wa(w.tel, MSG)} target="_blank" rel="noopener">
              <span class="tels__num">{w.label}</span>
              <span class="tels__wa"><Icon name="whatsapp" /> WhatsApp</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <form class="hoja" data-form data-tel={WHATSAPP[0].tel} novalidate data-sube>
      <header class="hoja__head">
        <span>Solicitud de obra</span>
        <span class="hoja__resp">Respuesta por WhatsApp</span>
      </header>

      <div class="campo">
        <label for="f-nombre">Tu nombre</label>
        <input id="f-nombre" name="nombre" autocomplete="name" required placeholder="Cómo te llamamos" aria-describedby="e-nombre" />
        <p class="campo__error" id="e-nombre">Escribe tu nombre para saber a quién responder.</p>
      </div>

      <div class="campo">
        <label for="f-negocio">Tu negocio y ciudad</label>
        <input id="f-negocio" name="negocio" autocomplete="organization" required placeholder="Nombre, a qué se dedica y dónde queda" aria-describedby="e-negocio" />
        <p class="campo__error" id="e-negocio">Cuéntanos el nombre del negocio y la ciudad.</p>
      </div>

      <fieldset class="campo opciones">
        <legend>¿Qué necesitas?</legend>
        <div class="opciones__grid">
          {opciones.map((o, i) => (
            <label class="opcion">
              <input type="radio" name="plan" value={o.nombre} checked={i === 0} />
              <span class="opcion__l" aria-hidden="true">{o.letra}</span>
              <span class="opcion__n">{o.nombre}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="campo">
        <label for="f-detalle">Cuéntanos un poco más <span class="opt">(opcional)</span></label>
        <textarea id="f-detalle" name="detalle" rows="3" placeholder="Qué vendes, cómo vendes hoy y qué te gustaría lograr"></textarea>
      </div>

      <div class="hoja__pie">
        <button type="submit" class="btn btn--azul">Enviar por WhatsApp <Icon name="arrow-ur" /></button>
        <p class="hoja__estado" role="status" data-estado></p>
        <p class="hoja__sinjs">
          Este formulario abre WhatsApp con tu mensaje ya escrito y para eso necesita JavaScript. Tu navegador lo tiene desactivado, así que escríbenos directo al{' '}
          {WHATSAPP.map((w, i) => (
            <>{i > 0 && <>{' '}o al{' '}</>}<a href={wa(w.tel, MSG)} target="_blank" rel="noopener">{w.label}</a></>
          ))}.
        </p>
      </div>
    </form>
  </div>
</section>

<style>
  .contacto__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .contacto__texto .titulo { margin-top: 18px; }
  .azul { color: var(--azul-300); }
  .contacto__lead { margin-top: 22px; }

  .tels { list-style: none; margin: clamp(28px, 3.4vw, 46px) 0 0; padding: 0; }
  .tels li + li { border-top: 1px solid color-mix(in srgb, var(--papel) 13%, transparent); }
  .tels a { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding: 18px 0; text-decoration: none; transition: color 0.35s var(--ease); }
  .tels a:hover { color: var(--azul-300); }
  .tels__num { font-size: clamp(1.5rem, 2.6vw, 2.3rem); font-weight: 800; letter-spacing: -0.03em; }
  .tels__wa { display: inline-flex; align-items: center; gap: 7px; font-family: var(--mono); font-size: var(--fs-mini); color: color-mix(in srgb, var(--papel) 56%, transparent); }
  .tels__wa :global(svg) { width: 16px; height: 16px; }

  .hoja {
    background: var(--papel); color: var(--tinta);
    border-radius: 14px; padding: clamp(20px, 2.6vw, 34px);
    box-shadow: 0 60px 80px -60px #000;
  }
  .hoja__head { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; padding-bottom: 14px; border-bottom: 1px solid var(--gris-300); font-family: var(--mono); font-size: var(--fs-mini); text-transform: uppercase; letter-spacing: 0.12em; }
  .hoja__resp { color: var(--gris-700); }

  .campo { margin-top: 20px; }
  .campo > label, .campo legend { display: block; font-size: var(--fs-small); font-weight: 700; color: var(--azul-700); }
  .opt { color: var(--gris-700); font-weight: 400; }
  .campo input, .campo textarea {
    width: 100%; margin-top: 6px;
    background: transparent; border: 0; border-bottom: 1px solid var(--gris-400);
    padding: 10px 0; font-size: 1.05rem; color: var(--tinta); border-radius: 0;
    transition: border-color 0.3s;
  }
  .campo textarea { resize: vertical; min-height: 84px; }
  .campo input::placeholder, .campo textarea::placeholder { color: var(--gris-600); }
  .campo input:focus, .campo textarea:focus { outline: none; border-color: var(--azul); }
  .campo__error { display: none; margin-top: 6px; font-size: var(--fs-small); font-weight: 650; color: #8a1f1f; }
  .campo.con-error input { border-color: #8a1f1f; }
  .campo.con-error .campo__error { display: block; }

  .opciones { border: 0; padding: 0; margin-inline: 0; }
  .opciones__grid { margin-top: 10px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .opcion {
    position: relative; display: flex; align-items: center; gap: 10px; cursor: pointer;
    padding: 9px 10px; border: 1px solid var(--gris-400); border-radius: 999px;
    transition: background 0.3s, border-color 0.3s, color 0.3s;
  }
  .opcion input { position: absolute; inset: 0; width: 1px; height: 1px; opacity: 0; pointer-events: none; }
  .opcion__l { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; border: 1px solid currentColor; font-size: var(--fs-mini); font-weight: 800; flex: none; }
  .opcion__n { font-size: var(--fs-small); font-weight: 650; line-height: 1.2; }
  .opcion:hover { border-color: var(--tinta); }
  .opcion:has(input:checked) { background: var(--tinta); color: var(--papel); border-color: var(--tinta); }
  .opcion:has(input:focus-visible) { outline: 2px solid var(--azul); outline-offset: 2px; }

  .hoja__pie { margin-top: 26px; display: flex; flex-wrap: wrap; align-items: center; gap: 14px 18px; }
  .hoja__estado { font-size: var(--fs-small); font-weight: 650; color: var(--azul-700); }
  .hoja__sinjs { display: none; font-size: var(--fs-small); line-height: 1.45; }
  :global(html:not(.motion)) .hoja__sinjs { display: block; }
  :global(html:not(.motion)) .hoja__pie .btn { display: none; }

  @media (max-width: 1000px) { .contacto__grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 520px) {
    .opciones__grid { grid-template-columns: minmax(0, 1fr); }
    .hoja__pie .btn { width: 100%; justify-content: center; }
  }
</style>
