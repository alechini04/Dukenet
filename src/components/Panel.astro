---
import { caja } from '../lib/iso';

const metricas = [
  { label: 'Visitas', valor: 4812, formato: 'int', tendencia: '+18%' },
  { label: 'Pedidos', valor: 167, formato: 'int', tendencia: '+11%' },
  { label: 'Conversión', valor: 3.47, formato: 'pct', tendencia: '+0,4 pts' },
  { label: 'Ticket promedio', valor: 78400, formato: 'cop', tendencia: '+6%' },
];
const fmt = (v: number, f: string) =>
  f === 'pct' ? v.toFixed(2).replace('.', ',') + '%' : f === 'cop' ? '$' + v.toLocaleString('es-CO') : v.toLocaleString('es-CO');

const semana = [
  { d: 'Lun', v: 38 }, { d: 'Mar', v: 52 }, { d: 'Mié', v: 44 }, { d: 'Jue', v: 66 },
  { d: 'Vie', v: 58 }, { d: 'Sáb', v: 79 }, { d: 'Dom', v: 94 },
];
const u = 26;
// moving the same amount on +x and -y keeps the screen row level: an isometric
// bar chart that reads as a chart instead of a staircase
const barras = semana.map((s, i) => ({ ...s, c: caja(i * 0.78, -i * 0.78, 0, 0.9, 0.9, (s.v / 100) * 3.2, u) }));

const embudo = [
  { paso: 'Visitaron la tienda', v: 4812 },
  { paso: 'Vieron un producto', v: 2140 },
  { paso: 'Agregaron al carrito', v: 402 },
  { paso: 'Pagaron', v: 167 },
];
---
<section id="panel" class="cap panel" data-cap="panel" aria-labelledby="panel-tit">
  <div class="marco panel__grid">
    <div class="panel__texto">
      <p class="cap__num">05 · Datos</p>
      <h2 id="panel-tit" class="titulo" data-parte>Dejas<br />de adivinar</h2>
      <p class="lead panel__lead" data-sube>Un panel en español, sin tecnicismos: de dónde llega la gente, qué mira, qué compra y en qué paso se va. Más un reporte mensual con lo que hicimos y lo que sigue.</p>
      <ul class="panel__lista" data-sube>
        <li>Visitas, origen y búsquedas</li>
        <li>Productos más vistos y más vendidos</li>
        <li>Carritos abandonados y en qué paso se caen</li>
      </ul>
    </div>

    <figure class="tablero" data-tablero data-sube>
      <figcaption class="tablero__head">
        <span>Panel de ventas <b>Últimos 30 días</b></span>
        <span class="tablero__ej">Ejemplo</span>
      </figcaption>

      <dl class="kpis">
        {metricas.map((m) => (
          <div class="kpi">
            <dt>{m.label}</dt>
            <dd class="kpi__v" data-cuenta={m.valor} data-formato={m.formato}>{fmt(m.valor, m.formato)}</dd>
            <dd class="kpi__t">{m.tendencia} <span>vs. mes anterior</span></dd>
          </div>
        ))}
      </dl>

      <div class="tablero__cols">
        <div class="bloque">
          <span class="bloque__lab">Pedidos por día</span>
          <svg class="iso grafica" viewBox="-30 -120 290 190" role="img" aria-label="Gráfica de ejemplo: los pedidos suben durante la semana y llegan al máximo el domingo">
            {barras.map((b, i) => (
              <g data-barra-iso style="opacity:0">
                <polygon class="der" points={b.c.der} />
                <polygon class="izq" points={b.c.izq} />
                <polygon class={i === barras.length - 1 ? 'top brillo' : 'top'} points={b.c.top} />
              </g>
            ))}
          </svg>
          <ol class="dias">{semana.map((s) => <li>{s.d}</li>)}</ol>
        </div>

        <div class="bloque">
          <span class="bloque__lab">¿En qué paso se van?</span>
          <ol class="embudo">
            {embudo.map((e) => (
              <li>
                <span class="embudo__txt">{e.paso}<b>{e.v.toLocaleString('es-CO')}</b></span>
                <span class="embudo__via"><i style={`--w:${Math.round((e.v / embudo[0].v) * 100)}%`} data-embudo></i></span>
              </li>
            ))}
          </ol>
        </div>
      </div>
      <p class="tablero__pie">Cifras de ejemplo para mostrar el formato del panel.</p>
    </figure>
  </div>
</section>

<style>
  .panel__grid { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr); gap: clamp(32px, 5vw, 80px); align-items: center; }
  .panel__texto .titulo { margin-top: 18px; }
  .panel__lead { margin-top: 22px; }
  .panel__lista { list-style: none; margin: 26px 0 0; padding: 0; display: grid; gap: 0; }
  .panel__lista li { display: flex; align-items: center; gap: 13px; padding: 13px 0; border-top: 1px solid color-mix(in srgb, var(--papel) 13%, transparent); font-weight: 600; font-size: var(--fs-small); }
  .panel__lista li::before { content: ''; width: 8px; height: 8px; background: var(--azul-300); flex: none; transform: rotate(45deg); }

  .tablero {
    position: relative; overflow: hidden;
    background: var(--tinta-2); border: 1px solid color-mix(in srgb, var(--papel) 12%, transparent);
    border-radius: var(--r-md); padding: clamp(18px, 2vw, 28px);
    box-shadow: 0 60px 80px -60px var(--negro);
  }
  .tablero__head { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid color-mix(in srgb, var(--papel) 12%, transparent); font-weight: 700; font-size: var(--fs-small); }
  .tablero__head b { font-family: var(--mono); font-weight: 400; font-size: var(--fs-mini); color: color-mix(in srgb, var(--papel) 54%, transparent); margin-left: 8px; }
  .tablero__ej { background: var(--azul); color: var(--tinta); padding: 3px 9px; border-radius: var(--r-pill); font-size: var(--fs-mini); }

  .kpis { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .kpi { padding: 18px 12px 16px 0; }
  .kpi + .kpi { padding-left: 14px; border-left: 1px solid color-mix(in srgb, var(--papel) 10%, transparent); }
  .kpi dt { font-family: var(--mono); font-size: var(--fs-mini); color: var(--azul-300); }
  .kpi__v { margin: 7px 0 0; font-size: var(--fs-d6); font-weight: 800; letter-spacing: -0.04em; line-height: 1; white-space: nowrap; }
  .kpi__t { margin: 8px 0 0; font-family: var(--mono); font-size: var(--fs-mini); color: var(--azul-300); }
  .kpi__t span { color: color-mix(in srgb, var(--papel) 58%, transparent); }

  .tablero__cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px; margin-top: 8px; }
  .bloque { background: var(--tinta); border: 1px solid color-mix(in srgb, var(--papel) 9%, transparent); border-radius: var(--r-sm); padding: 14px; }
  .bloque__lab { font-family: var(--mono); font-size: var(--fs-mini); color: color-mix(in srgb, var(--papel) 58%, transparent); }
  .grafica { margin-top: 6px; }
  .dias { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: 2px; font-family: var(--mono); font-size: var(--fs-micro); color: color-mix(in srgb, var(--papel) 60%, transparent); text-align: center; }

  .embudo { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 12px; }
  .embudo__txt { display: flex; justify-content: space-between; gap: 10px; font-size: var(--fs-small); }
  .embudo__txt b { font-family: var(--mono); font-weight: 400; color: var(--azul-300); }
  .embudo__via { display: block; margin-top: 6px; height: 8px; background: color-mix(in srgb, var(--papel) 8%, transparent); border-radius: var(--r-pill); overflow: hidden; }
  .embudo__via i { display: block; height: 100%; width: var(--w); background: var(--azul); border-radius: var(--r-pill); transform-origin: left; }

  .tablero__pie { margin-top: 14px; font-size: var(--fs-mini); color: color-mix(in srgb, var(--papel) 52%, transparent); }

  @media (max-width: 1000px) { .panel__grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 620px) {
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kpi:nth-child(3) { padding-left: 0; border-left: 0; }
    .tablero__cols { grid-template-columns: minmax(0, 1fr); }
  }
</style>
