---
const metricas = [
  { label: 'Visitas', valor: 4812, formato: 'mil', tendencia: '+18%' },
  { label: 'Pedidos', valor: 167, formato: 'int', tendencia: '+11%' },
  { label: 'Conversión', valor: 3.47, formato: 'pct', tendencia: '+0,4 pts' },
  { label: 'Ticket promedio', valor: 78400, formato: 'cop', tendencia: '+6%' },
];
const fmt = (v: number, f: string) =>
  f === 'pct' ? v.toFixed(2).replace('.', ',') + '%' : f === 'cop' ? '$' + v.toLocaleString('es-CO') : v.toLocaleString('es-CO');
const semana = [
  { d: 'Lun', v: 38 }, { d: 'Mar', v: 52 }, { d: 'Mié', v: 44 }, { d: 'Jue', v: 66 },
  { d: 'Vie', v: 58 }, { d: 'Sáb', v: 79 }, { d: 'Dom', v: 94 },
];
const embudo = [
  { paso: 'Visitaron la tienda', v: 4812 },
  { paso: 'Vieron un producto', v: 2140 },
  { paso: 'Agregaron al carrito', v: 402 },
  { paso: 'Pagaron', v: 167 },
];
---
<section id="panel" class="panel-sec" data-frente="panel" aria-labelledby="panel-title">
  <div class="wrap panel-sec__grid">
    <div class="panel-sec__copy">
      <h2 id="panel-title" class="t-display panel-sec__title" data-rise>Dejas de<br />adivinar</h2>
      <p class="panel-sec__lead" data-rise>Un panel en español, sin tecnicismos: de dónde llega la gente, qué mira, qué compra y en qué paso se va. Más un reporte mensual con lo que hicimos y lo que sigue.</p>
      <ul class="panel-sec__list" data-rise>
        <li>Visitas, origen y búsquedas</li>
        <li>Productos más vistos y más vendidos</li>
        <li>Carritos abandonados y en qué paso se caen</li>
      </ul>
    </div>

    <figure class="dash" data-dash>
      <div class="dash__head">
        <span class="dash__title">Panel de ventas <span class="t-plate">Últimos 30 días</span></span>
        <span class="t-plate dash__ejemplo">Ejemplo</span>
      </div>

      <dl class="dash__kpis">
        {metricas.map((m) => (
          <div class="kpi">
            <dt class="t-plate">{m.label}</dt>
            <dd class="kpi__val num" data-count={m.valor} data-format={m.formato}>{fmt(m.valor, m.formato)}</dd>
            <dd class="kpi__trend t-plate">
              <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 9 6 3l4 6" /></svg>
              {m.tendencia} <span>vs. mes anterior</span>
            </dd>
          </div>
        ))}
      </dl>

      <div class="dash__cols">
        <div class="dash__block">
          <span class="t-plate dash__label">Pedidos por día</span>
          <div class="chart" role="img" aria-label="Gráfica de ejemplo: los pedidos suben durante la semana y llegan al máximo el domingo">
            {semana.map((s, i) => (
              <div class="chart__col">
                <div class="chart__bar" style={`--h:${s.v}%`} data-bar class:list={[i === semana.length - 1 && 'is-top']}></div>
                <span class="chart__d t-plate">{s.d}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="dash__block">
          <span class="t-plate dash__label">¿En qué paso se van?</span>
          <ol class="embudo">
            {embudo.map((e) => (
              <li>
                <div class="embudo__txt"><span>{e.paso}</span><span class="num">{e.v.toLocaleString('es-CO')}</span></div>
                <div class="embudo__track"><div class="embudo__fill" style={`--w:${(e.v / embudo[0].v) * 100}%`} data-funnel></div></div>
              </li>
            ))}
          </ol>
        </div>
      </div>
      <figcaption class="dash__cap">Cifras de ejemplo para mostrar el formato del panel.</figcaption>
    </figure>
  </div>
</section>

<style>
  .panel-sec { background: var(--paper); color: var(--ink); padding-block: clamp(88px, 11vw, 170px); }
  .panel-sec__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(36px, 5vw, 90px); align-items: center; }
  .panel-sec__title { font-size: clamp(2.6rem, 6vw, 6.4rem); }
  .panel-sec__lead { margin-top: 24px; max-width: 44ch; font-size: clamp(1.05rem, 1.25vw, 1.25rem); color: var(--concrete-800); }
  .panel-sec__list { list-style: none; margin: 28px 0 0; padding: 0; display: grid; gap: 0; }
  .panel-sec__list li { display: flex; align-items: center; gap: 14px; padding-block: 13px; border-top: 1px solid var(--concrete-300); font-weight: 650; }
  .panel-sec__list li::before { content: ''; width: 10px; height: 10px; background: var(--sign); flex: none; }

  .dash { background: var(--ink); color: var(--paper); padding: clamp(20px, 2.4vw, 34px); box-shadow: 0 50px 90px -50px color-mix(in srgb, var(--sign-800) 90%, transparent); }
  .dash__head { display: flex; justify-content: space-between; align-items: center; padding-bottom: 16px; border-bottom: 1px solid color-mix(in srgb, var(--paper) 14%, transparent); }
  .dash__title { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; font-family: var(--font-display); font-weight: 750; text-transform: uppercase; letter-spacing: 0.02em; }
  .dash__title .t-plate { color: color-mix(in srgb, var(--paper) 55%, transparent); font-size: var(--fs-mini); }
  .dash__ejemplo { background: var(--sign); color: var(--ink); padding: 4px 8px 3px; font-weight: 700; }

  .dash__kpis { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .kpi { padding: 20px 14px 18px 0; }
  .kpi + .kpi { padding-left: 16px; border-left: 1px solid color-mix(in srgb, var(--paper) 12%, transparent); }
  .kpi dt { color: var(--sign-300); font-size: var(--fs-mini); }
  .kpi__val { margin: 8px 0 0; font-family: var(--font-display); font-weight: 850; font-size: clamp(1.6rem, 2.7vw, 2.8rem); line-height: 1; letter-spacing: -0.03em; white-space: nowrap; }
  .kpi__trend { margin: 10px 0 0; display: flex; flex-wrap: wrap; align-items: center; gap: 4px; color: var(--sign-300); font-size: var(--fs-mini); text-transform: none; letter-spacing: 0.02em; }
  .kpi__trend svg { width: 11px; height: 11px; fill: none; stroke: currentColor; stroke-width: 2; }
  .kpi__trend span { color: color-mix(in srgb, var(--paper) 50%, transparent); }

  .dash__cols { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; margin-top: 6px; }
  .dash__block { background: var(--ink-2); border: 1px solid color-mix(in srgb, var(--paper) 10%, transparent); padding: 16px; }
  .dash__label { color: color-mix(in srgb, var(--paper) 62%, transparent); font-size: var(--fs-mini); }

  .chart { margin-top: 14px; height: 170px; display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; align-items: end; }
  .chart__col { display: grid; grid-template-rows: 1fr auto; height: 100%; gap: 6px; }
  .chart__bar { align-self: end; height: var(--h); background: var(--sign-700); transform-origin: bottom; }
  .chart__bar.is-top { background: var(--sign-300); }
  .chart__d { text-align: center; font-size: var(--fs-micro); color: color-mix(in srgb, var(--paper) 50%, transparent); }

  .embudo { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 13px; }
  .embudo__txt { display: flex; justify-content: space-between; gap: 10px; font-size: var(--fs-small); }
  .embudo__txt .num { font-family: var(--font-plate); color: var(--sign-300); }
  .embudo__track { margin-top: 6px; height: 10px; background: color-mix(in srgb, var(--paper) 8%, transparent); overflow: hidden; }
  .embudo__fill { height: 100%; width: var(--w); background: var(--sign); transform-origin: left; }

  .dash__cap { margin-top: 14px; font-size: var(--fs-small); color: color-mix(in srgb, var(--paper) 58%, transparent); }

  @media (max-width: 1100px) {
    .panel-sec__grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 640px) {
    .dash__kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kpi:nth-child(3) { padding-left: 0; border-left: 0; }
    .kpi:nth-child(n + 3) { border-top: 1px solid color-mix(in srgb, var(--paper) 12%, transparent); }
    .dash__cols { grid-template-columns: 1fr; }
  }
</style>
