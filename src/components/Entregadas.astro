---
import Icon from './Icon.astro';
import { WHATSAPP, wa } from '../data/site';

const casos = [
  {
    nombre: 'El Gato Galletero',
    url: 'https://www.elgatogalletero.com/',
    dominio: 'elgatogalletero.com',
    tipo: 'Tienda en línea',
    estado: 'Entregada',
    texto: 'Tienda completa con causa: catálogo por categorías, combos y envíos a toda Colombia. Cada compra apoya el rescate de gatos en Bucaramanga.',
    desk: '/obras/gato-galletero.jpg',
    movil: '/obras/gato-galletero-movil.jpg',
  },
  {
    nombre: 'Suè',
    url: 'https://suue.shop/',
    dominio: 'suue.shop',
    tipo: 'Marca de moda',
    estado: 'Entregada',
    texto: 'Marca de ropa con tejidos hechos a mano: lanzamiento de colección, fotografía grande y compra directa, con editorial propio.',
    desk: '/obras/suue.jpg',
    movil: '/obras/suue-movil.jpg',
  },
];
const MSG = 'Hola DukeNet, quiero pedir el cupo del mes para la web de mi negocio.';
---
<section id="entregadas" class="cap entregadas" data-cap="entregadas" aria-labelledby="ent-tit">
  <div class="marco">
    <header class="entregadas__head">
      <div>
        <p class="cap__num">04 · Obras</p>
        <h2 id="ent-tit" class="titulo" data-parte>Entregadas<br />y funcionando</h2>
      </div>
      <p class="lead" data-sube>Ninguna se parece a la otra. Ese es justamente el punto.</p>
    </header>

    <div class="casos">
      {casos.map((c) => (
        <article class="caso">
          <a class="caso__vista" href={c.url} target="_blank" rel="noopener" aria-label={`Abrir ${c.dominio} en una pestaña nueva`} data-caso>
            <div class="caso__nav" aria-hidden="true">
              <i></i><i></i><i></i>
              <span>{c.dominio}</span>
            </div>
            <div class="caso__marco">
              <img src={c.desk} alt={`Página de inicio de ${c.nombre}`} width="1200" height="2167" loading="lazy" decoding="async" data-tira />
            </div>
            <div class="caso__movil" aria-hidden="true">
              <img src={c.movil} alt="" width="560" height="2297" loading="lazy" decoding="async" data-tira />
            </div>
          </a>
          <div class="caso__info" data-sube>
            <h3 class="caso__nombre">{c.nombre}</h3>
            <p class="caso__texto">{c.texto}</p>
            <dl class="caso__datos">
              <div><dt>Obra</dt><dd>{c.tipo}</dd></div>
              <div><dt>Estado</dt><dd><span class="etiqueta"><Icon name="check" />{c.estado}</span></dd></div>
              <div><dt>Sitio</dt><dd><a class="caso__link" href={c.url} target="_blank" rel="noopener">{c.dominio} <Icon name="arrow-ur" /></a></dd></div>
            </dl>
          </div>
        </article>
      ))}

      <article class="caso caso--cupo" data-sube>
        <div class="cupo">
          <h3 class="cupo__tit">Tu marca aquí</h3>
          <p class="cupo__txt">Hay cupo este mes. Tomamos pocos proyectos para acompañar cada uno de cerca.</p>
          <a class="btn btn--azul" href={wa(WHATSAPP[0].tel, MSG)} target="_blank" rel="noopener">Pedir el cupo del mes <Icon name="arrow-ur" /></a>
        </div>
        <div class="cupo__obra">
          <p class="cupo__nota"><b>Convite</b> · plataforma de bodas, en construcción: invitación digital, confirmación de asistencia y lista de regalos.</p>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  .entregadas__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: 24px 60px; align-items: end; }
  .entregadas__head .titulo { margin-top: 18px; }

  .casos { margin-top: clamp(48px, 6vw, 90px); display: grid; gap: clamp(56px, 7vw, 110px); }
  .caso { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: clamp(26px, 4vw, 64px); align-items: center; }

  .caso__vista {
    position: relative; display: block; text-decoration: none;
    padding-right: clamp(34px, 6vw, 92px);
    perspective: 1400px;
  }
  .caso__nav {
    display: flex; align-items: center; gap: 7px;
    background: var(--papel-2); color: var(--gris-700);
    padding: 9px 12px; border-radius: 8px 8px 0 0;
    font-family: var(--mono); font-size: var(--fs-mini);
  }
  .caso__nav i { width: 8px; height: 8px; border-radius: 50%; background: var(--gris-400); }
  .caso__nav i:first-child { background: var(--azul); }
  .caso__nav span { margin-inline: auto; }

  .caso__marco {
    position: relative; aspect-ratio: 16 / 10; overflow: hidden;
    background: #fff; border-radius: 0 0 8px 8px;
    box-shadow: 0 50px 70px -40px rgba(0, 0, 0, 0.8);
  }
  .caso__marco img { width: 100%; height: auto; transition: transform 5.5s cubic-bezier(0.45, 0, 0.2, 1); }

  .caso__movil {
    position: absolute; right: 0; bottom: -18px; width: clamp(92px, 14%, 172px);
    padding: 6px; border-radius: 22px; background: var(--tinta-3);
    border: 1px solid color-mix(in srgb, var(--papel) 18%, transparent);
    box-shadow: 0 30px 50px -22px rgba(0, 0, 0, 0.9);
  }
  .caso__movil img { width: 100%; height: auto; border-radius: 16px; transition: transform 4.5s cubic-bezier(0.45, 0, 0.2, 1); }

  @media (hover: hover) {
    .caso__vista:hover .caso__marco img { transform: translateY(calc(-100% + 56cqw)); }
    .caso__vista:hover .caso__movil img { transform: translateY(-62%); }
  }

  .caso__nombre { font-size: clamp(1.8rem, 3vw, 3rem); font-weight: 800; letter-spacing: -0.04em; }
  .caso__texto { margin-top: 14px; font-size: var(--fs-base); line-height: 1.5; color: color-mix(in srgb, var(--papel) 66%, transparent); max-width: 42ch; }
  .caso__datos { margin: 24px 0 0; display: grid; gap: 0; }
  .caso__datos > div { display: grid; grid-template-columns: 7rem 1fr; gap: 14px; padding: 11px 0; border-top: 1px solid color-mix(in srgb, var(--papel) 13%, transparent); align-items: center; }
  .caso__datos dt { font-family: var(--mono); font-size: var(--fs-mini); color: color-mix(in srgb, var(--papel) 52%, transparent); }
  .caso__datos dd { margin: 0; font-weight: 650; font-size: var(--fs-small); }
  .etiqueta { display: inline-flex; align-items: center; gap: 6px; background: var(--azul); color: var(--tinta); padding: 3px 10px; border-radius: 999px; font-size: var(--fs-mini); font-weight: 700; }
  .etiqueta :global(svg) { width: 13px; height: 13px; }
  .caso__link { display: inline-flex; align-items: center; gap: 7px; padding: 3px 0 4px; font-family: var(--mono); font-size: var(--fs-small); color: var(--azul-300); text-decoration: none; border-bottom: 1px solid currentColor; }
  .caso__link :global(svg) { width: 14px; height: 14px; }

  .caso--cupo { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; gap: clamp(20px, 3vw, 48px); padding: clamp(26px, 3.4vw, 46px); border: 1px dashed color-mix(in srgb, var(--azul-300) 42%, transparent); }
  .cupo__tit { font-size: clamp(2rem, 4vw, 3.6rem); font-weight: 800; letter-spacing: -0.04em; color: var(--azul-300); }
  .cupo__txt { margin-top: 12px; color: color-mix(in srgb, var(--papel) 68%, transparent); max-width: 34ch; }
  .cupo .btn { margin-top: 22px; }
  .cupo__nota { font-size: var(--fs-small); color: color-mix(in srgb, var(--papel) 58%, transparent); border-left: 2px solid var(--azul); padding-left: 16px; }
  .cupo__nota b { color: var(--papel); }

  @media (max-width: 860px) { .entregadas__head { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 1000px) {
    .caso, .caso--cupo { grid-template-columns: minmax(0, 1fr); }
    .caso__vista { padding-right: 42px; }
  }
  @media (max-width: 560px) {
    /* the label column no longer fits beside the value */
    .caso__datos > div { grid-template-columns: minmax(0, 1fr); gap: 2px; }
    .caso__movil { width: 86px; bottom: -12px; }
    .caso__vista { padding-right: 34px; }
  }
</style>
