---
import Icon from './Icon.astro';
import { WHATSAPP, wa } from '../data/site';
const MSG = 'Hola DukeNet, quiero información para la web de mi negocio.';
---
<footer class="pie">
  <div class="marco">
    <p class="pie__marca" aria-label="DukeNet">
      <span aria-hidden="true">Duke</span><span class="pie__net" aria-hidden="true">Net</span>
    </p>
    <div class="pie__grid">
      <p class="pie__claim">Desarrollo web a medida para negocios de toda Colombia.</p>
      <nav class="pie__cols" aria-label="Contacto y obras">
        <div>
          <span class="pie__lab">WhatsApp</span>
          <ul>{WHATSAPP.map((w) => <li><a href={wa(w.tel)} target="_blank" rel="noopener">{w.label}</a></li>)}</ul>
        </div>
        <div>
          <span class="pie__lab">Obras entregadas</span>
          <ul>
            <li><a href="https://www.elgatogalletero.com/" target="_blank" rel="noopener">elgatogalletero.com</a></li>
            <li><a href="https://suue.shop/" target="_blank" rel="noopener">suue.shop</a></li>
          </ul>
        </div>
        <div>
          <span class="pie__lab">Sitio</span>
          <ul>
            <li><a href="#obras">Qué hacemos</a></li>
            <li><a href="#montaje">Cómo</a></li>
            <li><a href="#contacto">Cotizar</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="pie__base">
      <span>© 2026 DukeNet</span>
      <a href="#inicio" class="pie__arriba">Volver arriba <Icon name="arrow-ur" /></a>
    </div>
  </div>
</footer>

<a class="flota btn btn--azul oculta" href={wa(WHATSAPP[0].tel, MSG)} target="_blank" rel="noopener" data-flota aria-label="Escríbenos por WhatsApp">
  <Icon name="whatsapp" /><span>Escríbenos</span>
</a>

<style>
  .pie { padding-block: clamp(70px, 9vw, 130px) 28px; border-top: 1px solid color-mix(in srgb, var(--papel) 10%, transparent); }
  .pie__marca { display: flex; align-items: baseline; font-weight: 800; letter-spacing: -0.05em; font-size: clamp(3.2rem, 14.5vw, 14rem); line-height: 0.85; }
  .pie__net { color: var(--azul-300); }
  .pie__grid { margin-top: clamp(36px, 5vw, 64px); display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 32px; padding-top: 26px; border-top: 1px solid color-mix(in srgb, var(--papel) 13%, transparent); }
  .pie__claim { max-width: 26ch; font-size: clamp(1.1rem, 1.6vw, 1.5rem); font-weight: 700; line-height: 1.25; }
  .pie__cols { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .pie__lab { font-family: var(--mono); font-size: var(--fs-mini); color: var(--azul-300); letter-spacing: 0.14em; text-transform: uppercase; }
  .pie__cols ul { list-style: none; margin: 8px 0 0; padding: 0; display: grid; }
  .pie__cols a { display: inline-block; padding-block: 5px; overflow-wrap: anywhere; text-decoration: none; color: color-mix(in srgb, var(--papel) 74%, transparent); transition: color 0.3s; }
  .pie__cols a:hover { color: var(--papel); }
  .pie__base { margin-top: 48px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 14px; font-family: var(--mono); font-size: var(--fs-mini); color: color-mix(in srgb, var(--papel) 52%, transparent); }
  .pie__arriba { display: inline-flex; flex: none; align-items: center; gap: 6px; padding-block: 5px; margin-block: -5px; text-decoration: none; }
  .pie__arriba :global(svg) { width: 13px; height: 13px; }
  .pie__arriba:hover { color: var(--papel); }

  .flota {
    position: fixed; right: clamp(14px, 2vw, 26px); bottom: clamp(14px, 2vw, 26px); z-index: 90;
    box-shadow: 0 16px 34px -10px rgba(0, 0, 0, 0.7);
    transition: opacity 0.4s, visibility 0s linear 0.4s, transform 0.5s var(--ease);
  }
  .flota.oculta { opacity: 0; visibility: hidden; transform: translateY(16px); pointer-events: none; }
  .flota :global(svg) { width: 1.2em; height: 1.2em; }

  @media (max-width: 760px) {
    .pie__grid { grid-template-columns: minmax(0, 1fr); }
    .pie__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) { .flota span { display: none; } }
</style>
