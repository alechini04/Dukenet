---
import Icon from './Icon.astro';
import { SERVICIOS } from '../data/site';
---
<section id="servicios" class="cap servicios" data-cap="servicios" aria-labelledby="serv-tit">
  <div class="marco">
    <header class="serv__head">
      <div>
        <p class="tag tag--linea">01 · Servicios</p>
        <h2 id="serv-tit" class="titulo serv__tit" data-parte>Cuatro maneras<br />de crecer</h2>
      </div>
      <p class="lead" data-sube>Cada obra se diseña para tu negocio. Elige por dónde quieres empezar y cotiza solo eso.</p>
    </header>

    <ol class="serv__lista">
      {SERVICIOS.map((s, i) => (
        <li class="serv caja" data-sube>
          <span class="serv__n">0{i + 1}</span>
          <h3 class="serv__nombre">{s.nombre}</h3>
          <p class="serv__corto">{s.corto}</p>
          <p class="serv__texto">{s.texto}</p>
          <ul class="serv__incluye">
            {s.incluye.map((x) => <li><Icon name="check" />{x}</li>)}
          </ul>
          <a class="serv__cta" href="/#contacto" data-plan={s.nombre}>{s.cta} <Icon name="arrow-ur" /></a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .serv__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); gap: 24px 60px; align-items: end; }
  .serv__tit { margin-top: 18px; }

  .serv__lista { list-style: none; margin: clamp(40px, 5vw, 76px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .serv {
    display: flex; flex-direction: column; gap: 12px;
    padding: clamp(18px, 1.8vw, 26px);
    transition: background 0.5s var(--ease), border-color 0.5s var(--ease), transform 0.5s var(--ease);
  }
  .serv:hover { border-color: color-mix(in srgb, var(--azul-300) 40%, transparent); background: color-mix(in srgb, var(--tinta-2) 96%, transparent); transform: translateY(-4px); }
  .serv__n { font-family: var(--mono); font-size: var(--fs-micro); letter-spacing: 0.2em; color: var(--azul-300); }
  .serv__nombre { font-size: var(--fs-t1); font-weight: 700; margin-top: 4px; }
  .serv__corto { font-family: var(--mono); font-size: var(--fs-micro); letter-spacing: 0.1em; text-transform: uppercase; color: color-mix(in srgb, var(--papel) 58%, transparent); }
  .serv__texto { font-size: var(--fs-small); line-height: 1.5; color: color-mix(in srgb, var(--papel) 58%, transparent); }
  .serv__incluye { list-style: none; margin: 4px 0 0; padding: 14px 0 0; border-top: 1px solid var(--linea); display: grid; gap: 7px; }
  .serv__incluye li { display: flex; gap: 9px; align-items: center; font-size: var(--fs-small); }
  .serv__incluye :global(svg) { width: 14px; height: 14px; color: var(--azul-300); flex: none; }
  .serv__cta { margin-top: auto; padding-top: 18px; display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: var(--fs-micro); letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; color: var(--azul-300); }
  .serv__cta :global(svg) { width: 13px; height: 13px; transition: transform 0.4s var(--ease); }
  .serv__cta:hover :global(svg) { transform: translate(3px, -3px); }

  @media (max-width: 1100px) { .serv__lista { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .serv__head { grid-template-columns: minmax(0, 1fr); } .serv__lista { grid-template-columns: minmax(0, 1fr); } }
</style>
