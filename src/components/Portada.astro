---
import Icon from './Icon.astro';
import { WHATSAPP, wa, SERVICIOS } from '../data/site';
const MSG = 'Hola DukeNet, quiero información para la web de mi negocio.';
---
<section id="inicio" class="cap cap--alto portada" data-cap="inicio"
>
  <div class="marco portada__grid">
    <div class="portada__texto">
      <p class="tag tag--linea" data-aparece>Estudio de desarrollo web · Colombia</p>

      <h1 class="portada__titulo" data-titulo>
        <span class="ln"><span>No hacemos</span></span>
        <span class="ln"><span class="tachado" data-tachado>páginas bonitas</span></span>
        <span class="ln"><span class="azul">hacemos ventas</span></span>
      </h1>

      <p class="lead portada__lead" data-aparece>
        Diseñamos y programamos desde cero la web de tu negocio —tienda, catálogo o landing— con datos claros y acompañamiento mes a mes. <strong>Nada de plantillas.</strong>
      </p>

      <div class="portada__cta" data-aparece>
        <a class="btn btn--azul" href="/#contacto">Cotizar mi web <Icon name="arrow-ur" /></a>
        {WHATSAPP.map((w) => (
          <a class="btn" href={wa(w.tel, MSG)} target="_blank" rel="noopener"><Icon name="whatsapp" /> {w.label}</a>
        ))}
      </div>
    </div>

    <div class="portada__objeto" data-objeto="nucleo" aria-hidden="true"></div>
  </div>

  <div class="marco portada__pie">
    <ul class="portada__frentes" data-aparece>
      {SERVICIOS.map((s) => (
        <li><a href={`/#serv-${s.id}`}>{s.nombre}</a></li>
      ))}
    </ul>
    <a class="portada__baja" href="/#porque" aria-label="Bajar al contenido"><span></span></a>
  </div>
</section>

<style>
  .portada { padding-top: clamp(104px, 14vh, 160px); padding-bottom: clamp(80px, 10vh, 120px); align-content: space-between; }
  .portada__grid { display: grid; grid-template-columns: minmax(0, 0.98fr) minmax(0, 1.02fr); gap: clamp(24px, 4vw, 70px); align-items: center; flex: 1; }

  .portada__titulo { margin-top: 22px; font-size: var(--fs-hero); line-height: 0.92; letter-spacing: -0.05em; font-weight: 700; }
  .ln { display: block; overflow: hidden; padding-block: 0.12em 0.04em; margin-block: -0.12em -0.04em; }
  .ln > span { display: block; }
  .portada__titulo .ln:nth-child(2) > span { white-space: nowrap; }
  .azul { color: var(--azul-300); }
  .ln > span.tachado { position: relative; display: inline-block; color: color-mix(in srgb, var(--papel) 40%, transparent); }
  .tachado::after { content: ''; position: absolute; left: -0.02em; right: -0.02em; top: 52%; height: 2px; background: var(--azul); transform: scaleX(var(--tachado, 1)); transform-origin: left; }

  /* El hueco donde se dibuja el núcleo: el 3D nunca se inventa dónde va */
  .portada__objeto { min-height: clamp(280px, 52vh, 620px); }
  :global(html:not(.con-3d)) .portada__objeto { display: none; }

  .portada__lead { margin-top: 24px; }
  .portada__cta { margin-top: 30px; display: flex; flex-wrap: wrap; gap: 10px; }

  /* El pie de la portada ya nombra los cuatro servicios: son los protagonistas */
  .portada__pie { margin-top: clamp(40px, 7vh, 86px); display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .portada__frentes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 10px; }
  .portada__frentes a {
    display: inline-flex; align-items: center; min-height: 34px; padding: 0 14px;
    border: 1px solid var(--linea); border-radius: var(--r-pill);
    font-family: var(--mono); font-size: var(--fs-micro); letter-spacing: 0.14em; text-transform: uppercase;
    color: color-mix(in srgb, var(--papel) 62%, transparent); text-decoration: none;
    transition: color 0.4s var(--ease), border-color 0.4s var(--ease), background 0.4s var(--ease);
  }
  .portada__frentes a:hover { color: var(--tinta); background: var(--azul-300); border-color: var(--azul-300); }

  .portada__baja { flex: none; width: 24px; height: 38px; border: 1px solid var(--linea-fuerte); border-radius: var(--r-pill); display: grid; justify-items: center; padding-top: 7px; }
  .portada__baja span { width: 2px; height: 7px; background: var(--azul-300); border-radius: var(--r-pill); }
  :global(html.motion:not(.rm)) .portada__baja span { animation: baja 1.9s var(--ease-io) infinite; }
  @keyframes baja { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(14px); opacity: 0; } 71% { transform: translateY(0); opacity: 0; } 100% { opacity: 1; } }

  @media (max-width: 1040px) {
    .portada__grid { grid-template-columns: minmax(0, 1fr); }
    .portada { padding-top: clamp(96px, 16vh, 150px); }
  }
  @media (max-width: 560px) {
    .portada__cta .btn { width: 100%; justify-content: center; }
    .portada__baja { display: none; }
  }
</style>
