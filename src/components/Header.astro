---
import Icon from './Icon.astro';
import { WHATSAPP, wa } from '../data/site';
const nav = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#proceso', label: 'Proceso' },
  { href: '/#obras', label: 'Trabajos' },
  { href: '/#datos', label: 'Datos' },
  { href: '/#contacto', label: 'Contacto' },
];
const MSG = 'Hola DukeNet, quiero información para la web de mi negocio.';
---
<header class="hdr" data-hdr>
  <div class="hdr__bar marco">
    <span class="hdr__lado" aria-hidden="true"></span>

    <a href="/#inicio" class="marca" aria-label="DukeNet, ir al inicio">
      <span class="marca__cuadro" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="marca__txt">Duke<b>Net</b></span>
    </a>

    <div class="hdr__lado hdr__lado--fin">
      <button class="boton-menu" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle>
        <span class="boton-menu__txt" data-menu-label>Menú</span>
        <span class="boton-menu__ico" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>
  <div class="hdr__avance" aria-hidden="true"><i data-avance></i></div>
</header>

<div class="menu" id="menu" data-menu hidden>
  <div class="menu__fondo"></div>
  <nav class="marco menu__cuerpo" aria-label="Menú">
    <ul class="menu__lista">
      {nav.map((n) => (
        <li><a href={n.href} data-menu-link data-navlink={n.href.slice(2)}><span>{n.label}</span></a></li>
      ))}
    </ul>
    <div class="menu__pie">
      <a href="/#contacto" class="btn btn--azul menu__cta" data-menu-link>Cotizar mi web <Icon name="arrow-ur" /></a>
      <ul class="lectura menu__tels">
        {WHATSAPP.map((w) => (
          <li><a href={wa(w.tel, MSG)} target="_blank" rel="noopener"><b>WhatsApp</b> {w.label}</a></li>
        ))}
        <li><b>Base</b> Bucaramanga · toda Colombia</li>
      </ul>
    </div>
  </nav>
</div>

<style>
  .hdr { position: fixed; inset: 0 0 auto 0; z-index: 100; transition: background 0.5s var(--ease), backdrop-filter 0.5s; }
  .hdr.is-pegado { background: color-mix(in srgb, var(--tinta) 78%, transparent); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); }
  .hdr__bar { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; height: 76px; }
  .hdr__lado { display: flex; }
  .hdr__lado--fin { justify-content: flex-end; }

  /* La marca, centrada y con su peso: Duke en papel, Net en azul */
  .marca { display: inline-flex; align-items: center; gap: 12px; padding-block: 6px; text-decoration: none; }
  .marca__cuadro { display: grid; grid-template-columns: repeat(2, 7px); gap: 2.5px; }
  .marca__cuadro i { width: 7px; height: 7px; background: var(--azul-300); transition: background 0.5s var(--ease); }
  .marca__cuadro i:nth-child(4) { background: var(--papel); }
  .marca:hover .marca__cuadro i:nth-child(1) { background: var(--papel); }
  .marca:hover .marca__cuadro i:nth-child(4) { background: var(--azul-300); }
  .marca__txt { font-weight: 700; font-size: var(--fs-logo); letter-spacing: -0.045em; line-height: 1; }
  .marca__txt b { color: var(--azul-300); font-weight: 700; }

  .boton-menu {
    display: inline-flex; align-items: center; gap: 12px;
    min-height: 44px; padding: 0 6px 0 18px;
    background: transparent; border: 1px solid var(--linea-fuerte); border-radius: var(--r-pill);
    font-family: var(--mono); font-size: var(--fs-micro); letter-spacing: 0.18em; text-transform: uppercase;
    cursor: pointer; transition: border-color 0.4s var(--ease), color 0.4s var(--ease);
  }
  .boton-menu:hover { border-color: var(--azul-300); color: var(--azul-200); }
  .boton-menu__ico { display: grid; gap: 5px; width: 32px; height: 32px; place-content: center; border-radius: var(--r-pill); background: color-mix(in srgb, var(--papel) 8%, transparent); }
  .boton-menu__ico i { display: block; width: 14px; height: 1px; background: currentColor; transition: transform 0.45s var(--ease); }
  .boton-menu[aria-expanded='true'] .boton-menu__ico i:first-child { transform: translateY(3px) rotate(45deg); }
  .boton-menu[aria-expanded='true'] .boton-menu__ico i:last-child { transform: translateY(-3px) rotate(-45deg); }

  .hdr__avance { height: 1px; background: var(--linea); }
  .hdr__avance i { display: block; height: 100%; background: var(--azul-300); transform: scaleX(0); transform-origin: left; }

  /* ── Menú a pantalla completa ───────────────────────────────────────── */
  .menu { position: fixed; inset: 0; z-index: 99; display: grid; align-content: center; overflow-y: auto; overscroll-behavior: contain; padding-block: 110px 48px; }
  .menu[hidden] { display: none; }
  .menu__fondo { position: absolute; inset: 0; background: color-mix(in srgb, var(--tinta) 92%, transparent); -webkit-backdrop-filter: blur(24px); backdrop-filter: blur(24px); }
  .menu__cuerpo { position: relative; }
  .menu__lista { list-style: none; margin: 0; padding: 0; }
  .menu__lista li { border-bottom: 1px solid var(--linea); }
  .menu__lista li:first-child { border-top: 1px solid var(--linea); }
  .menu__lista a {
    display: block; padding: clamp(14px, 2.2vh, 24px) 0; text-decoration: none;
    font-size: var(--fs-d4); font-weight: 700; letter-spacing: -0.045em; line-height: 1;
    color: color-mix(in srgb, var(--papel) 70%, transparent);
    transition: color 0.4s var(--ease);
  }
  .menu__lista a span { display: inline-block; transition: transform 0.5s var(--ease); }
  .menu__lista a:hover, .menu__lista a[aria-current='true'] { color: var(--papel); }
  .menu__lista a:hover span { transform: translateX(18px); }
  .menu__lista a[aria-current='true'] { color: var(--azul-300); }

  .menu__pie { margin-top: clamp(26px, 4vh, 48px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 22px; }
  .menu__tels a { text-decoration: none; }
  .menu__tels a:hover { color: var(--azul-200); }

  @media (max-width: 560px) {
    .hdr__bar { height: 66px; }
    .boton-menu { padding-left: 14px; gap: 9px; }
    .menu__pie { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 380px) { .boton-menu__txt { display: none; } .boton-menu { padding-left: 6px; } }
</style>
