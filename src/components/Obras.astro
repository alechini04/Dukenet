---
import Icon from './Icon.astro';
import { SERVICIOS } from '../data/site';
---
<section id="obras" class="obras" data-frente="obras" aria-labelledby="obras-title">
  <div class="wrap">
    <div class="obras__head">
      <h2 id="obras-title" class="t-display obras__title" data-rise>Cuatro maneras<br />de crecer</h2>
      <p class="obras__intro" data-rise>Cada obra se diseña para tu negocio. Elige un tipo para ver qué incluye.</p>
    </div>

    <div class="obras__body" data-tabs>
      <div class="obras__tabs" role="tablist" aria-label="Tipos de obra" aria-orientation="vertical">
        {SERVICIOS.map((s, i) => (
          <button
            class="tab"
            role="tab"
            id={`tab-${s.id}`}
            aria-controls={`panel-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-tab={i}
          >
            <span class="tab__letra">{s.letra}</span>
            <span class="tab__txt">
              <span class="tab__nombre">{s.nombre}</span>
              <span class="tab__corto">{s.corto}</span>
            </span>
            <Icon name="arrow-r" class="tab__arrow" />
          </button>
        ))}
      </div>

      <div class="obras__panels">
        {SERVICIOS.map((s, i) => (
          <div
            class="panel"
            role="tabpanel"
            id={`panel-${s.id}`}
            aria-labelledby={`tab-${s.id}`}
            hidden={i !== 0}
            data-panel={i}
          >
            <figure class="panel__photo duo">
              <img src={s.foto} alt={s.alt} width="1400" height="1000" loading={i === 0 ? 'eager' : 'lazy'} />
              <span class="panel__tag t-plate">Obra tipo {s.letra}</span>
            </figure>
            <div class="panel__info">
              <h3 class="panel__nombre">{s.nombre}</h3>
              <p class="panel__texto">{s.texto}</p>
              <div class="panel__incluye">
                <span class="t-plate">Incluye</span>
                <ul>
                  {s.incluye.map((x) => <li><Icon name="check" />{x}</li>)}
                </ul>
              </div>
              <a class="plate plate--sign panel__cta" href="#contacto" data-plan={s.nombre}>{s.cta} <Icon name="arrow-ur" /></a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .obras { background: var(--paper); color: var(--ink); padding-block: clamp(88px, 11vw, 170px); }
  .obras__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 24px 60px; }
  .obras__title { font-size: clamp(2.6rem, 6.8vw, 7.2rem); }
  .obras__intro { max-width: 34ch; font-size: clamp(1.02rem, 1.2vw, 1.2rem); color: var(--concrete-800); }

  .obras__body {
    margin-top: clamp(44px, 5.5vw, 84px);
    display: grid; grid-template-columns: minmax(280px, 4fr) minmax(0, 8fr);
    gap: clamp(20px, 3vw, 48px); align-items: start;
  }

  .obras__tabs { display: grid; gap: 10px; position: sticky; top: 96px; }
  .tab {
    display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px;
    width: 100%; text-align: left; cursor: pointer;
    padding: 16px 18px 16px 14px;
    background: transparent; color: var(--ink);
    border: 2px dashed color-mix(in srgb, var(--ink) 38%, transparent);
    transition: background 0.5s var(--ease-out), border-color 0.5s var(--ease-out), color 0.5s var(--ease-out);
  }
  .tab:hover { border-color: var(--ink); }
  .tab__letra {
    display: grid; place-items: center; width: 46px; height: 46px;
    font-family: var(--font-display); font-weight: 900; font-size: 1.5rem; line-height: 1;
    border: 2px solid currentColor;
    padding-top: 3px;
  }
  .tab__nombre { display: block; font-family: var(--font-display); font-weight: 800; font-size: clamp(1.1rem, 1.5vw, 1.4rem); line-height: 1.1; text-transform: uppercase; letter-spacing: -0.005em; }
  .tab__corto { display: block; margin-top: 3px; font-size: var(--fs-note); color: var(--concrete-700); transition: color 0.5s var(--ease-out); }
  .tab :global(.tab__arrow) { width: 22px; height: 22px; opacity: 0; transform: translateX(-8px); transition: opacity 0.4s, transform 0.5s var(--ease-out); }

  .tab[aria-selected='true'] { background: var(--ink); color: var(--paper); border-style: solid; border-color: var(--ink); }
  .tab[aria-selected='true'] .tab__letra { background: var(--sign); color: var(--ink); border-color: var(--sign); }
  .tab[aria-selected='true'] .tab__corto { color: var(--concrete-400); }
  .tab[aria-selected='true'] :global(.tab__arrow) { opacity: 1; transform: none; color: var(--sign-400); }

  .panel {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    background: var(--ink); color: var(--paper);
    overflow: hidden; min-height: 520px;
  }
  .panel[hidden] { display: none; }
  .panel__photo { min-height: 320px; }
  .panel__photo img { position: absolute; inset: 0; }
  .panel__tag { position: absolute; top: 14px; left: 14px; z-index: 2; background: var(--paper); color: var(--ink); padding: 6px 10px; }

  .panel__info { display: flex; flex-direction: column; padding: clamp(26px, 3vw, 48px); }
  .panel__nombre { font-weight: 850; text-transform: uppercase; font-size: clamp(2rem, 3.4vw, 3.4rem); line-height: 0.95; letter-spacing: -0.03em; }
  .panel__texto { margin-top: 18px; max-width: 46ch; color: color-mix(in srgb, var(--paper) 78%, transparent); font-size: clamp(1rem, 1.12vw, 1.12rem); }
  .panel__incluye { margin-top: 26px; padding-top: 18px; border-top: 1px solid color-mix(in srgb, var(--paper) 16%, transparent); }
  .panel__incluye .t-plate { color: var(--sign-400); }
  .panel__incluye ul { list-style: none; margin: 12px 0 0; padding: 0; display: grid; gap: 9px; }
  .panel__incluye li { display: flex; gap: 10px; align-items: center; font-weight: 600; }
  .panel__incluye :global(svg) { width: 18px; height: 18px; color: var(--sign-400); flex: none; }
  .panel__cta { margin-top: auto; align-self: flex-start; }
  .panel__incluye + .panel__cta { margin-top: 30px; }

  @media (max-width: 1100px) {
    .panel { grid-template-columns: 1fr; }
    .panel__photo { aspect-ratio: 16 / 9; min-height: 0; }
  }
  @media (max-width: 860px) {
    .obras__body { grid-template-columns: 1fr; }
    .obras__tabs { position: static; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .tab { grid-template-columns: auto 1fr; padding: 12px; gap: 12px; }
    :global(.tab__arrow), .tab__corto { display: none; }
    .tab__letra { width: 38px; height: 38px; font-size: 1.2rem; }
    .tab__nombre { font-size: var(--fs-note); hyphens: auto; }
  }
  @media (max-width: 480px) {
    .obras__tabs { grid-template-columns: 1fr; }
  }
</style>
