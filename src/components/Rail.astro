---
// Barrier-stripe threshold between frentes, carrying the frente plate on its right end.
interface Props { code: string; name: string }
const { code, name } = Astro.props;
---
<div class="umbral" aria-hidden="true">
  <div class="rail"></div>
  <span class="umbral__plate t-plate"><b>{code}</b>{name}</span>
</div>

<style>
  /* sits above the neighbouring sections so the plate is never clipped by them */
  .umbral { position: relative; z-index: 5; }
  .umbral__plate {
    position: absolute; right: var(--gutter); top: 50%; transform: translateY(-50%);
    display: inline-flex; align-items: center; gap: 8px;
    background: var(--ink); color: var(--paper); padding: 5px 10px 4px 5px;
    border: 1px solid color-mix(in srgb, var(--paper) 30%, transparent);
  }
  .umbral__plate b { background: var(--sign); color: var(--ink); padding: 2px 6px 1px; font-weight: 700; }
</style>
