---
import { FASES } from '../data/site';
// Las notas del diagnóstico: lo que dice un negocio cualquiera en la primera
// reunión. Genéricas a propósito: aquí no se muestra el trabajo de un cliente.
const notas = ['Vende por encargo y por WhatsApp', 'Quiere recibir pedidos sin contestar llamadas', 'Cuarenta productos y envíos en la ciudad'];
// bloques del plano: la estructura real de una home de tienda
const bloques = [
  { id: 'nav', x: 3, y: 4, w: 94, h: 9, label: 'Encabezado' },
  { id: 'cat', x: 3, y: 15, w: 94, h: 6, label: 'Categorías' },
  { id: 'hero', x: 3, y: 23, w: 94, h: 34, label: 'Portada' },
  { id: 'tit', x: 26, y: 31, w: 48, h: 9, label: 'Titular' },
  { id: 'cta', x: 42, y: 44, w: 16, h: 6, label: 'Comprar' },
  { id: 'p1', x: 3, y: 60, w: 29, h: 28, label: 'Producto' },
  { id: 'p2', x: 35.5, y: 60, w: 29, h: 28, label: 'Producto' },
  { id: 'p3', x: 68, y: 60, w: 29, h: 28, label: 'Producto' },
];
---
<section id="proceso" class="cap proceso" data-cap="proceso" aria-labelledby="proc-tit" data-proceso
>
  <div class="proceso__pin" data-proceso-pin>
    <div class="marco proceso__grid">
      <div class="proceso__texto">
        <p class="tag tag--linea">Proceso</p>
        <h2 id="proc-tit" class="titulo proceso__tit">Cinco fases,<br />cero misterio</h2>

        <ol class="pista" aria-hidden="true">
          {FASES.map((_, i) => <li data-pista={i}><i></i></li>)}
        </ol>

        <ol class="fases" data-fases>
          {FASES.map((f, i) => (
            <li class={`fase ${i === 0 ? 'activa' : ''}`} data-fase={i}>
              <span class="fase__n">Fase {f.n}</span>
              <h3 class="fase__nombre">{f.nombre}</h3>
              <p class="fase__texto">{f.texto}</p>
              <p class="fase__entrega">Entregable · <b>{f.entrega}</b></p>
            </li>
          ))}
        </ol>
      </div>

      <figure class="proceso__obra" aria-label="Animación: una página se construye en cinco fases, de las notas de la primera reunión al sitio publicado">
        <div class="ventana caja">
          <div class="ventana__barra">
            <span class="ventana__puntos" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="ventana__url"><span data-url>tunegocio.com</span><i class="cursor-barra" data-caret></i></span>
            <span class="ventana__vivo" data-vivo aria-hidden="true"><i></i>en línea</span>
          </div>

          <div class="lienzo">
            <div class="capa capa--plano" data-capa="plano"></div>

            <div class="capa capa--notas" data-capa="notas">
              {notas.map((n, i) => <p class="nota" data-nota style={`--i:${i}`}>{n}</p>)}
            </div>

            <div class="capa" data-capa="wire">
              {bloques.map((b) => (
                <span class="wire" data-wire style={`left:${b.x}%;top:${b.y}%;width:${b.w}%;height:${b.h}%`}>
                  <i>{b.label}</i>
                </span>
              ))}
            </div>

            <div class="capa" data-capa="skel">
              {bloques.map((b) => (
                <span class={`skel ${b.id === 'cta' ? 'skel--azul' : ''}`} data-skel style={`left:${b.x}%;top:${b.y}%;width:${b.w}%;height:${b.h}%`}></span>
              ))}
            </div>

            <!-- El sitio publicado: dibujado, no la captura de ningún cliente -->
            <div class="capa sitio" data-capa="sitio" aria-hidden="true">
              <div class="sitio__nav"><span class="sitio__marca"></span><i></i><i></i><i></i><span class="sitio__bolsa"></span></div>
              <div class="sitio__cats">{[0, 1, 2, 3, 4].map(() => <i></i>)}</div>
              <div class="sitio__hero">
                <span class="sitio__tit"></span><span class="sitio__tit sitio__tit--corto"></span>
                <span class="sitio__btn">Comprar</span>
              </div>
              <div class="sitio__fila">
                {[0, 1, 2].map(() => (
                  <span class="sitio__prod"><i class="sitio__foto"></i><i class="sitio__linea"></i><i class="sitio__precio"></i></span>
                ))}
              </div>
            </div>
            <span class="barrido" data-barrido aria-hidden="true"></span>

            <div class="panelito caja" data-capa="panel">
              <span class="panelito__t">Reporte del mes <b>Ejemplo</b></span>
              <span class="panelito__barras" aria-hidden="true">
                {[34, 52, 44, 66, 58, 82].map((v) => <i style={`--h:${v}%`} data-pbarra></i>)}
              </span>
            </div>
          </div>
        </div>
        <figcaption class="lectura proceso__pie"><b>maqueta</b> así se construye la tuya</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .proceso { padding: 0; }
  .proceso__pin { min-height: 100svh; display: grid; align-content: center; padding-block: clamp(90px, 12vh, 150px); }
  .proceso__grid { display: grid; grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr); gap: clamp(26px, 4vw, 64px); align-items: center; }
  .proceso__tit { margin-top: 18px; }

  .pista { list-style: none; margin: clamp(24px, 3vw, 38px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 5px; }
  .pista li { height: 2px; background: var(--linea); overflow: hidden; }
  .pista i { display: block; height: 100%; background: var(--azul-300); transform: scaleX(0); transform-origin: left; }

  .fases { list-style: none; margin: 24px 0 0; padding: 0; }
  .fase { display: grid; gap: 8px; }
  .fase__n { font-family: var(--mono); font-size: var(--fs-micro); letter-spacing: 0.2em; text-transform: uppercase; color: var(--azul-300); }
  .fase__nombre { font-size: var(--fs-d5); font-weight: 700; }
  .fase__texto { font-size: var(--fs-base); line-height: 1.55; color: color-mix(in srgb, var(--papel) 64%, transparent); max-width: 40ch; }
  .fase__entrega { font-family: var(--mono); font-size: var(--fs-micro); letter-spacing: 0.1em; text-transform: uppercase; color: color-mix(in srgb, var(--papel) 58%, transparent); }
  .fase__entrega b { color: var(--papel); font-weight: 400; }

  :global(html.motion:not(.rm)) .fases { display: grid; grid-template-areas: 'apilado'; }
  :global(html.motion:not(.rm)) .fase { grid-area: apilado; opacity: 0; visibility: hidden; transform: translateY(12px); transition: opacity 0.4s var(--ease), transform 0.5s var(--ease), visibility 0s linear 0.4s; }
  :global(html.motion:not(.rm)) .fase.activa { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  :global(html:not(.motion)) .fases { display: grid; gap: 24px; }

  .proceso__obra { position: relative; }
  .proceso__pie { position: absolute; left: 0; bottom: -24px; display: block; }
  .lienzo { position: relative; aspect-ratio: 16 / 10.4; overflow: hidden; background: var(--tinta-2); }
  .capa { position: absolute; inset: 0; }

  .capa--plano {
    background-image: linear-gradient(90deg, var(--rejilla) 1px, transparent 1px), linear-gradient(var(--rejilla) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .nota {
    position: absolute; max-width: 30%; padding: 9px 11px;
    background: var(--papel); color: var(--tinta);
    font-size: var(--fs-micro); line-height: 1.35; font-weight: 600;
    box-shadow: 0 14px 24px -14px var(--negro);
  }
  .nota:nth-child(1) { left: 7%; top: 16%; transform: rotate(-2deg); }
  .nota:nth-child(2) { left: 40%; top: 46%; transform: rotate(1.5deg); }
  .nota:nth-child(3) { left: 66%; top: 22%; transform: rotate(-1deg); }

  .wire { position: absolute; border: 1px solid var(--azul-300); }
  .wire i { position: absolute; left: 5px; top: 4px; font-family: var(--mono); font-size: var(--fs-nano); letter-spacing: 0.1em; text-transform: uppercase; color: var(--azul-300); font-style: normal; }
  .skel { position: absolute; background: var(--tinta-4); }
  .skel--azul { background: var(--azul); }

  /* ── El sitio publicado ─────────────────────────────────────────────── */
  .sitio { background: var(--papel); padding: 3%; display: grid; grid-template-rows: 9% 6% 1fr 28%; gap: 2%; align-content: start; }
  .sitio__nav { display: flex; align-items: center; gap: 4%; padding-inline: 2%; background: var(--blanco); border: 1px solid color-mix(in srgb, var(--tinta) 10%, transparent); }
  .sitio__marca { width: 16%; height: 34%; background: var(--tinta); }
  .sitio__nav i { width: 9%; height: 14%; background: color-mix(in srgb, var(--tinta) 32%, transparent); }
  .sitio__bolsa { margin-left: auto; width: 6%; aspect-ratio: 1; border: 1.5px solid var(--azul); }
  .sitio__cats { display: grid; grid-template-columns: repeat(5, 1fr); gap: 1.4%; }
  .sitio__cats i { background: color-mix(in srgb, var(--azul) 16%, transparent); }
  .sitio__hero {
    display: grid; align-content: center; justify-items: center; gap: 4%;
    background: linear-gradient(118deg, var(--azul-900), var(--azul-700) 52%, var(--azul) 100%);
  }
  .sitio__tit { width: 46%; height: 11%; background: color-mix(in srgb, var(--papel) 92%, transparent); }
  .sitio__tit--corto { width: 28%; height: 8%; background: color-mix(in srgb, var(--papel) 58%, transparent); }
  .sitio__btn {
    display: grid; place-items: center; width: 22%; min-height: 13%; padding: 0.4em;
    background: var(--azul-200); color: var(--tinta-2);
    font-family: var(--mono); font-size: var(--fs-nano); letter-spacing: 0.14em; text-transform: uppercase;
  }
  .sitio__fila { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2%; }
  .sitio__prod { display: grid; grid-template-rows: 1fr auto auto; gap: 6%; background: var(--blanco); padding: 4%; border: 1px solid color-mix(in srgb, var(--tinta) 8%, transparent); }
  .sitio__foto { background: color-mix(in srgb, var(--azul) 22%, transparent); }
  .sitio__linea { height: 7px; background: color-mix(in srgb, var(--tinta) 24%, transparent); }
  .sitio__precio { height: 7px; width: 40%; background: var(--azul); }

  .barrido { position: absolute; top: 0; bottom: 0; left: 0; width: 2px; background: var(--azul-200); box-shadow: 0 0 20px 5px color-mix(in srgb, var(--azul-300) 60%, transparent); opacity: 0; }

  .panelito { position: absolute; right: 4%; bottom: 6%; width: 36%; padding: 12px; background: color-mix(in srgb, var(--tinta) 88%, transparent); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
  .panelito__t { display: block; font-family: var(--mono); font-size: var(--fs-micro); letter-spacing: 0.1em; text-transform: uppercase; color: color-mix(in srgb, var(--papel) 60%, transparent); }
  .panelito__t b { color: var(--azul-300); font-weight: 400; }
  .panelito__barras { display: grid; grid-template-columns: repeat(6, 1fr); gap: 5px; align-items: end; height: 46px; margin-top: 10px; }
  .panelito__barras i { height: var(--h); background: var(--azul-700); transform-origin: bottom; }
  .panelito__barras i:last-child { background: var(--azul-300); }

  .cursor-barra { display: inline-block; width: 6px; height: 11px; margin-left: 2px; background: var(--azul-300); vertical-align: -1px; }
  :global(html.motion:not(.rm)) .cursor-barra { animation: parpadeo 1.1s steps(1) infinite; }
  @keyframes parpadeo { 50% { opacity: 0; } }
  .ventana__vivo { opacity: 0; }

  /* Sin JavaScript la maqueta no puede construirse sola, así que se muestra
     terminada: el sitio publicado, el panel y el sello de "en línea". */
  :global(html:not(.motion)) [data-capa='plano'],
  :global(html:not(.motion)) [data-capa='notas'],
  :global(html:not(.motion)) [data-capa='wire'],
  :global(html:not(.motion)) [data-capa='skel'],
  :global(html:not(.motion)) .cursor-barra { opacity: 0; }
  :global(html:not(.motion)) .ventana__vivo { opacity: 1; }

  @media (max-width: 1000px) {
    .proceso__grid { grid-template-columns: minmax(0, 1fr); gap: 22px; }
    .fase__texto { max-width: none; }
    .proceso__pie { display: none; }
  }
</style>
