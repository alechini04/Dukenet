---
import Icon from './Icon.astro';
import { WHATSAPP, wa, FASES } from '../data/site';
const MSG = 'Hola DukeNet, quiero información para la web de mi negocio.';
---
<section id="inicio" class="hero" data-frente="inicio">
  <div class="wrap hero__frame escena">
    <div class="hero__escena">
      <span class="hero__charco" aria-hidden="true"></span>

      <div class="valla" data-valla data-tilt="1.4" data-glint>
        <span class="glint" aria-hidden="true"></span>
        <span class="bolt bolt--tl" aria-hidden="true"></span>
        <span class="bolt bolt--tr" aria-hidden="true"></span>
        <span class="bolt bolt--bl" aria-hidden="true"></span>
        <span class="bolt bolt--br" aria-hidden="true"></span>

        <h1 class="hero__title t-display" data-hero-title data-paralaje="-0.6">
          <span class="line"><span class="line__in">No hacemos</span></span>
          <span class="line"><span class="line__in"><span class="tachado" data-tachado><span class="tw">páginas</span> <span class="tw">bonitas</span></span></span></span>
          <span class="line"><span class="line__in hero__ink">hacemos ventas</span></span>
        </h1>

        <div class="hero__pitch" data-hero-pitch>
          <p class="hero__lead">
            Diseñamos y programamos desde cero la web de tu negocio (tienda, catálogo o landing) con estadísticas claras y acompañamiento mes a mes. <strong>Nada de plantillas.</strong>
          </p>
          <div class="hero__cta">
            <a class="plate" href="#contacto">Cotizar mi obra <Icon name="arrow-ur" /></a>
            {WHATSAPP.map((w) => (
              <a class="plate plate--ghost-dark" href={wa(w.tel, MSG)} target="_blank" rel="noopener">
                <Icon name="whatsapp" /> {w.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <aside class="ficha" aria-label="Ficha de obra" data-ficha data-paralaje="2.8" data-tilt="2.2">
        <header class="ficha__head">
          <span class="t-plate">Ficha de obra</span>
          <span class="t-plate ficha__ref">DKN · web a medida</span>
        </header>
        <dl class="ficha__rows">
          <div><dt>Proyecto</dt><dd>La web de tu negocio</dd></div>
          <div><dt>Constructor</dt><dd>DukeNet, estudio de desarrollo web</dd></div>
          <div><dt>Diseño</dt><dd>Propio, desde cero</dd></div>
          <div><dt>Cobertura</dt><dd>Toda Colombia</dd></div>
          <div><dt>Entrega</dt><dd>Fecha fija en la propuesta</dd></div>
          <div><dt>Seguimiento</dt><dd>Reporte mes a mes</dd></div>
        </dl>
        <div class="etapas">
          <span class="t-plate etapas__label">Etapas</span>
          <ol class="etapas__track" data-etapas>
            {FASES.map((f, i) => <li class={i === 0 ? 'is-on' : ''}><span class="etapas__dot" aria-hidden="true"></span><span class="etapas__txt">{f.nombre}</span></li>)}
          </ol>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid; align-items: center;
    padding-top: calc(67px + clamp(16px, 3vw, 48px)); padding-bottom: clamp(84px, 13vh, 150px);
  }
  .hero__frame { max-width: none; }
  .hero__escena { position: relative; width: 100%; max-width: 1240px; margin-inline: auto; }

  /* the light the sign spills on the floor of the room */
  .hero__charco {
    position: absolute; left: 50%; bottom: -8%; width: 86%; height: 34%;
    transform: translateX(-50%);
    background: radial-gradient(50% 50% at 50% 50%, color-mix(in srgb, var(--sign) 55%, transparent), transparent 70%);
    filter: blur(44px); opacity: 0.55; pointer-events: none;
  }

  .valla {
    position: relative; z-index: 1;
    min-height: min(58svh, 580px);
    display: grid; grid-template-rows: 1fr auto; gap: clamp(24px, 3vw, 44px);
    padding: clamp(40px, 5vw, 72px) clamp(26px, 4vw, 64px) clamp(32px, 4vw, 56px);
    background: var(--sign);
    color: var(--paper);
    border-radius: var(--radius-sign);
    isolation: isolate;
    overflow: hidden;
  }
  .valla::before {
    content: ''; position: absolute; inset: clamp(8px, 0.8vw, 12px); z-index: -1;
    border: clamp(3px, 0.32vw, 5px) solid var(--paper);
    border-radius: calc(var(--radius-sign) - 6px);
    pointer-events: none;
  }

  .hero__title {
    align-self: start;
    font-size: clamp(2.8rem, min(7.6vw, 13.5svh), 8.2rem);
    line-height: 0.86;
  }
  .line { display: block; overflow: hidden; padding-block: 0.14em 0.04em; margin-block: -0.14em -0.04em; }
  .line__in { display: block; }
  .hero__ink { color: var(--ink); }

  .tachado { --tachado: 1; }
  .tw { position: relative; display: inline-block; }
  .tw::after {
    content: ''; position: absolute; left: -0.03em; right: -0.03em; top: 40%;
    height: 0.12em; background: var(--ink);
    transform: scaleX(var(--tachado)); transform-origin: left center;
  }

  .hero__pitch { max-width: min(58%, 660px); }
  .hero__lead {
    max-width: 44ch; color: var(--ink);
    font-size: clamp(1.02rem, 1.25vw, 1.3rem); line-height: 1.5; font-weight: 450;
  }
  .hero__lead strong { font-weight: 800; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: clamp(20px, 2.2vw, 32px); }

  /* The ficha is no longer a sheet inside the sign: it is a panel hanging in
     front of it, closer to the camera, lit from behind by the sign itself. */
  .ficha {
    position: absolute; z-index: 2;
    right: clamp(-44px, -3vw, -16px); bottom: clamp(-72px, -5vw, -36px);
    width: min(410px, 34vw);
    padding: 18px 20px 20px;
    background: color-mix(in srgb, var(--ink) 72%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.25);
    backdrop-filter: blur(16px) saturate(1.25);
    border: 1px solid color-mix(in srgb, var(--sign-300) 40%, transparent);
    color: var(--paper);
    box-shadow: 0 40px 80px -40px #000;
  }
  .ficha__head { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 12px; border-bottom: 1px solid color-mix(in srgb, var(--sign-300) 45%, transparent); }
  .ficha__head .t-plate:first-child { font-weight: 700; color: var(--paper); }
  .ficha__ref { color: var(--sign-300); }
  .ficha__rows { margin: 0; display: grid; grid-template-columns: 1fr 1fr; column-gap: 20px; }
  .ficha__rows > div {
    display: grid; gap: 2px;
    padding: 9px 0; border-bottom: 1px solid color-mix(in srgb, var(--paper) 14%, transparent);
  }
  .ficha dt { font-family: var(--font-plate); font-size: var(--fs-plate); letter-spacing: 0.06em; text-transform: uppercase; color: var(--sign-300); }
  .ficha dd { margin: 0; font-weight: 650; font-size: var(--fs-base); line-height: 1.3; color: var(--paper); }

  .etapas { padding-top: 14px; }
  .etapas__label { color: var(--sign-300); font-size: var(--fs-plate); }
  .etapas__track {
    list-style: none; margin: 10px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 4px;
  }
  .etapas__track li {
    position: relative; padding-top: 14px;
    font-size: var(--fs-plate); font-weight: 650; line-height: 1.15; color: color-mix(in srgb, var(--paper) 62%, transparent);
    transition: color 0.5s var(--ease-out);
  }
  .etapas__track li::before {
    content: ''; position: absolute; left: 0; right: 0; top: 4px; height: 3px;
    background: color-mix(in srgb, var(--paper) 18%, transparent); transition: background 0.5s var(--ease-out);
  }
  .etapas__dot {
    position: absolute; left: 0; top: 0; width: 11px; height: 11px; border-radius: 50%;
    background: var(--ink); border: 2px solid color-mix(in srgb, var(--paper) 35%, transparent);
    transition: border-color 0.5s var(--ease-out), background 0.5s var(--ease-out);
  }
  .etapas__track li.is-done::before, .etapas__track li.is-on::before { background: var(--sign-300); }
  .etapas__track li.is-on { color: var(--paper); }
  .etapas__track li.is-on .etapas__dot { background: var(--sign-300); border-color: var(--paper); }
  .etapas__track li.is-done .etapas__dot { border-color: var(--sign-300); }

  @media (max-width: 1100px) {
    .ficha { width: min(360px, 42vw); }
    .hero__pitch { max-width: min(54%, 520px); }
  }
  @media (max-width: 860px) {
    .hero { min-height: 0; padding-bottom: clamp(40px, 7vh, 90px); }
    .valla { min-height: 0; }
    .hero__pitch { max-width: none; }
    .ficha { position: static; width: auto; margin-top: 18px; }
    .hero__charco { bottom: 10%; }
  }
  @media (max-width: 480px) {
    .etapas__txt {
      position: absolute; width: 1px; height: 1px; overflow: hidden;
      clip-path: inset(50%); white-space: nowrap;
    }
    .etapas__track li { padding-top: 8px; }
    .ficha__rows { grid-template-columns: 1fr; }
    .hero__title { font-size: clamp(2.6rem, 12.6vw, 4.6rem); }
    .hero__cta .plate { width: 100%; justify-content: space-between; }
    .ficha__ref { display: none; }
  }
</style>
