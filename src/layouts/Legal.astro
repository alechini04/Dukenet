---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LEGAL } from '../data/legal';

interface Props { title: string; description: string; numero: string; titulo: string; intro: string; indice: { id: string; t: string }[] }
const { title, description, numero, titulo, intro, indice } = Astro.props;
---
<Base title={title} description={description}>
  <Header />
  <main id="contenido" class="legal">
    <div class="marco">
      <header class="legal__head">
        <p class="cap__num">{numero}</p>
        <h1 class="legal__tit">{titulo}</h1>
        <p class="lead legal__intro">{intro}</p>
        <p class="legal__fechas">
          <span>Vigente desde: <b>{LEGAL.vigencia}</b></span>
          <span>Última actualización: <b>{LEGAL.actualizado}</b></span>
        </p>
      </header>

      <div class="legal__cuerpo">
        <nav class="legal__indice" aria-label="Contenido de esta política">
          <span class="legal__indice-t">En esta página</span>
          <ol>{indice.map((i) => <li><a href={`#${i.id}`}>{i.t}</a></li>)}</ol>
        </nav>
        <div class="legal__texto">
          <slot />
        </div>
      </div>
    </div>
  </main>
  <Footer />
  <script>
    import '../scripts/app';
  </script>
</Base>

<style is:global>
  .legal { padding-top: clamp(110px, 14vh, 170px); padding-bottom: clamp(70px, 9vw, 120px); }
  .legal__head { max-width: 62ch; }
  .legal__tit { margin-top: 16px; font-size: var(--fs-d3); font-weight: 800; letter-spacing: -0.04em; line-height: 0.98; }
  .legal__intro { margin-top: 18px; }
  .legal__fechas { margin-top: 20px; display: flex; flex-wrap: wrap; gap: 8px 26px; font-family: var(--mono); font-size: var(--fs-mini); color: color-mix(in srgb, var(--papel) 56%, transparent); }
  .legal__fechas b { color: var(--papel); font-weight: 500; }

  .legal__cuerpo {
    margin-top: clamp(36px, 5vw, 64px);
    display: grid; grid-template-columns: minmax(0, 0.32fr) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 70px); align-items: start;
  }

  .legal__indice { position: sticky; top: 100px; }
  .legal__indice-t { font-family: var(--mono); font-size: var(--fs-mini); letter-spacing: 0.18em; text-transform: uppercase; color: var(--azul-300); }
  .legal__indice ol { list-style: none; margin: 14px 0 0; padding: 0; display: grid; gap: 2px; counter-reset: idx; }
  .legal__indice a {
    display: flex; gap: 10px; padding: 7px 0; text-decoration: none; font-size: var(--fs-small);
    color: color-mix(in srgb, var(--papel) 62%, transparent); transition: color 0.3s var(--ease);
  }
  .legal__indice li { counter-increment: idx; }
  .legal__indice a::before { content: counter(idx, decimal-leading-zero); font-family: var(--mono); font-size: var(--fs-mini); color: var(--azul-300); }
  .legal__indice a:hover { color: var(--papel); }

  .legal__texto { max-width: 72ch; }
  .legal__texto h2 {
    margin-top: clamp(34px, 4vw, 52px); padding-top: 22px;
    border-top: 1px solid color-mix(in srgb, var(--papel) 13%, transparent);
    font-size: var(--fs-t0); font-weight: 800; letter-spacing: -0.03em;
    scroll-margin-top: 96px;
  }
  .legal__texto h2:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
  .legal__texto h3 { margin-top: 26px; font-size: var(--fs-t2); font-weight: 750; letter-spacing: -0.02em; color: var(--azul-300); }
  .legal__texto p { margin-top: 14px; color: color-mix(in srgb, var(--papel) 76%, transparent); }
  .legal__texto ul, .legal__texto ol.lista { margin: 14px 0 0; padding-left: 0; list-style: none; display: grid; gap: 9px; }
  .legal__texto ul li, .legal__texto ol.lista li { display: grid; grid-template-columns: auto 1fr; gap: 12px; color: color-mix(in srgb, var(--papel) 76%, transparent); }
  .legal__texto ul li::before { content: ''; width: 7px; height: 7px; margin-top: 0.55em; background: var(--azul-300); transform: rotate(45deg); }
  .legal__texto ol.lista { counter-reset: li; }
  .legal__texto ol.lista li { counter-increment: li; }
  .legal__texto ol.lista li::before { content: counter(li, decimal-leading-zero); font-family: var(--mono); font-size: var(--fs-mini); color: var(--azul-300); padding-top: 0.35em; }
  .legal__texto b, .legal__texto strong { color: var(--papel); font-weight: 700; }
  .legal__texto a { color: var(--azul-300); }
  .legal__texto .dl { margin: 14px 0 0; display: grid; gap: 0; }
  .legal__texto .dl > div { display: grid; grid-template-columns: 11rem 1fr; gap: 6px 16px; padding: 10px 0; border-bottom: 1px solid color-mix(in srgb, var(--papel) 10%, transparent); }
  .legal__texto .dl dt { font-family: var(--mono); font-size: var(--fs-mini); color: color-mix(in srgb, var(--papel) 56%, transparent); }
  .legal__texto .dl dd { margin: 0; font-weight: 600; }
  .pendiente { color: var(--azul-300); font-family: var(--mono); font-size: var(--fs-small); }

  @media (max-width: 900px) {
    .legal__cuerpo { grid-template-columns: minmax(0, 1fr); }
    .legal__indice { position: static; }
    .legal__indice ol { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .legal__texto .dl > div { grid-template-columns: minmax(0, 1fr); }
    .legal__indice ol { grid-template-columns: minmax(0, 1fr); }
  }
</style>
